            </div>
          </div>
          <p class="photo-hint">TAP A WINDOW TO DRAW THE CURTAINS & REVEAL THE MEMORY</p>
        </div>
      </section>
      <section
        id="venue"
        class="page venue-page"
        aria-label="Venue & travel"
        data-label="Venue & travel"
      >
        <div class="scene garden-scene" aria-hidden="true"></div>
        <div class="haze" aria-hidden="true"></div>
        <div class="page-content">
          <div class="page-heading reveal">
            <p class="stop-label">STOP 06 · COASTAL WEDDING EXPRESS</p>
            <h2>Venue & Travel</h2>
            <p class="subtitle">OUR DESTINATION</p>
            <div class="ornament" aria-hidden="true">
              <span></span>✧<span></span>
            </div>
          </div>
          <div class="venue-picture reveal">
            <img
              src={content.assets.venue}
              alt="A floral wedding pavilion overlooking the sea"
              class=""
              loading="lazy"
            />
          </div>
          <div class="venue-ticket paper-card reveal">
            <h3>
              {content.venue}
              <br />
              <span>{content.location}</span>
            </h3>
            <p>
              A seaside celebration amidst
              <br />
              palm trees and ocean breezes.
            </p>
            <a
              href="https://maps.google.com/?q=The+Palm+Pavilion+Goa"
              target="_blank"
              rel="noopener noreferrer"
              class="primary-button venue-map-link"
            >
              VIEW ON GOOGLE MAPS <span>↗</span>
            </a>
          </div>
          <div class="travel-map reveal">
            <img
              src={content.assets.map}
              alt="Illustrative coastal map with sea, palm groves and railway"
              class=""
              loading="lazy"
            />
            <div class="map-venue">
              ⌖ {content.venue}
              <small>GOA</small>
            </div>
            <div class="map-airport">
              ✈ GOA AIRPORT
              <br />
              <small>28 KM · PDF REFERENCE</small>
            </div>
            <div class="map-station">
              ▣ MADGAON STATION
              <br />
              <small>12 KM · PDF REFERENCE</small>
            </div>
          </div>
        </div>
      </section>
      <section id="rsvp" class="page rsvp-page" aria-label="RSVP" data-label="RSVP">
        <div class="scene bridge-scene" aria-hidden="true">
          <video
            class="scene-video"
            muted
            loop
            playsinline
            preload="none"
            poster={import.meta.env.BASE_URL + content.assets.bridge}
            aria-hidden="true"
            tabindex="-1"
          >
            <source src={import.meta.env.BASE_URL + 'assets/train2.mp4'} type="video/mp4" />
          </video>
        </div>
        <div class="haze" aria-hidden="true"></div>
        <div class="page-content">
          <div class="page-heading reveal">
            <p class="stop-label">STOP 07 · COASTAL WEDDING EXPRESS</p>
            <h2>RSVP</h2>
            <p class="subtitle">KINDLY CONFIRM YOUR SEAT</p>
            <div class="ornament" aria-hidden="true">
              <span></span>✧<span></span>
            </div>
          </div>
          <form id="rsvp-form" class="rsvp-form paper-card rsvp-ticket-card reveal">
            <div class="ticket-notch notch-left" aria-hidden="true"></div>
            <div class="ticket-notch notch-right" aria-hidden="true"></div>

            <div class="rsvp-ticket-heading">
              <div class="ticket-class-badge" aria-hidden="true">
                <span class="ticket-star">★</span>
                <span>FIRST CLASS PASSENGER RESERVATION</span>
                <span class="ticket-star">★</span>
              </div>
              <span class="eyebrow">YOUR PLACE ON OUR JOURNEY</span>
              <h3>Save your seat</h3>
              <p>We would love to celebrate with you on board the Coastal Wedding Express.</p>
              <div class="ticket-perforation-divider" aria-hidden="true"></div>
            </div>

            <div class="form-group-block">
              <label for="guest-name">
                YOUR NAME <span class="required-mark">*</span>
              </label>
              <input
                id="guest-name"
                name="name"
                required
                autocomplete="name"
                maxlength="100"
                placeholder="e.g. Rohan Mehta"
              />
            </div>

            <fieldset class="rsvp-custom-fieldset">
              <legend>
                WILL YOU BE JOINING US? <span class="required-mark">*</span>
              </legend>
              <div class="radio-options ticket-radio-group">
                <label class="ticket-radio-option" id="radio-card-yes">
                  <input type="radio" name="attending" value="yes" checked required />
                  <div class="radio-option-body">
                    <span class="radio-station-icon">🚂</span>
                    <div class="radio-text-wrap">
                      <strong class="radio-title">Yes, can't wait!</strong>
                      <span class="radio-sub">Reserving my seat for the celebrations</span>
                    </div>
                    <span class="radio-check-marker">✓</span>
                  </div>
                </label>
                <label class="ticket-radio-option" id="radio-card-no">
                  <input type="radio" name="attending" value="no" />
                  <div class="radio-option-body">
                    <span class="radio-station-icon">💌</span>
                    <div class="radio-text-wrap">
                      <strong class="radio-title">Sorry, can't make it</strong>
                      <span class="radio-sub">Celebrating in spirit from afar</span>
                    </div>
                    <span class="radio-check-marker">✓</span>
                  </div>
                </label>
              </div>
            </fieldset>

            <div class="form-group-block guest-stepper-container" id="guest-stepper-wrap">
              <label for="guests">
                NUMBER OF GUESTS <span class="required-mark">*</span>
              </label>
              <div class="luxury-passenger-stepper" aria-hidden="true">
                <button type="button" class="stepper-action-btn minus-btn" id="guest-minus" aria-label="Decrease guest count">−</button>
                <div class="stepper-count-readout">
                  <span class="stepper-digit" id="stepper-digit">1</span>
                  <span class="stepper-unit" id="stepper-unit">GUEST (FIRST CLASS)</span>
                </div>
                <button type="button" class="stepper-action-btn plus-btn" id="guest-plus" aria-label="Increase guest count">+</button>
              </div>
              <select id="guests" name="guests" class="stepper-sync-select">
                <option value="1">1 Guest</option>
                <option value="2">2 Guests</option>
                <option value="3">3 Guests</option>
                <option value="4">4 Guests</option>
                <option value="5">5 Guests</option>
                <option value="6">6 Guests</option>
              </select>
            </div>

            <div class="form-group-block">
              <label for="notes">
                ANY SPECIAL NOTES? <small>(OPTIONAL)</small>
              </label>
              <textarea
                id="notes"
                name="notes"
                rows="3"
                maxlength="500"
                placeholder="e.g. Dietary preferences or musical blessings"
              ></textarea>
            </div>

            <button type="submit" class="primary-button rsvp-submit-btn">
              <span> RSVP</span> <span>⟶</span>
            </button>
            <p class="draft-note">Design preview only. Your response is not sent or saved.</p>
            <p id="rsvp-result" class="rsvp-result" role="status" hidden></p>
          </form>
        </div> 
      </section>
      <section id="guide" class="page guide-page" aria-label="Guest guide" data-label="Guest guide">
        <div class="scene garden-scene" aria-hidden="true"></div>
        <div class="haze" aria-hidden="true"></div>
        <div class="page-content">
          <div class="page-heading reveal">
            <p class="stop-label">STOP 08 · COASTAL WEDDING EXPRESS</p>
            <h2>Guest Guide</h2>
            <p class="subtitle">EVERYTHING FOR A SMOOTH JOURNEY</p>
            <div class="ornament" aria-hidden="true">
              <span></span>✧<span></span>
            </div>
          </div>
          <div class="guide-list">
            <article class="guide-card paper-card reveal">
              <div class="guide-icon">
                <svg
                  viewBox="0 0 32 32"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M8 7 12 4h8l4 3 5 8-5 3-3-5v16H11V13l-3 5-5-3Z M12 4q4 8 8 0" />
                </svg>
                <span>Attire</span>
              </div>
              <div>
                <h3>Dress Code</h3>
                <p>
                  Festive Indian Attire
                  <br />
                  Brights, Pastels & Beach Chic
                </p>
              </div>
            </article>
            <article class="guide-card paper-card reveal">
              <div class="guide-icon">
                <svg
                  viewBox="0 0 32 32"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 16V9h22v7 M3 28V17h26v11 M3 23h26 M7 13h6m6 0h6" />
                </svg>
                <span>Stay</span>
              </div>
              <div>
                <h3>Stay</h3>
                <p>A comfortable stay, close to the celebration.</p>
                <button class="text-button" data-info="stay">
                  VIEW STAY OPTIONS<span>⟶</span>
                </button>
              </div>
            </article>
            <article class="guide-card paper-card reveal">
              <div class="guide-icon">
                <svg
                  viewBox="0 0 32 32"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M4 25 28 7M17 6l11 1-2 11M5 7h7M4 12h4M7 27h19" />
                </svg>
                <span>Travel</span>
              </div>
              <div>
                <h3>Travel</h3>
                <p>
                  Airport: Goa (GOI)
                  <br />
                  Railway: Madgaon (MAO)
                </p>
                <button class="text-button" data-info="travel">
                  TRAVEL INFO<span>⟶</span>
                </button>
              </div>
            </article>
            <article class="guide-card paper-card reveal">
              <div class="guide-icon">
                <svg
                  viewBox="0 0 32 32"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M6 8h20v16H6Z M6 8l10 9L26 8 M12 27h8" />
                </svg>
                <span>Contact</span>
              </div>
              <div>
                <h3>Contact</h3>
                <p>For any queries, reach out to our wedding team.</p>
                <button class="text-button" data-info="contact">
                  GET IN TOUCH<span>⟶</span>
                </button>
              </div>
            </article>
          </div>
          <div class="farewell postcard tilted reveal">
            <img src={content.assets.postmark} alt="" class="stamp" loading="lazy" />
            <p>See you on board!</p>
            <span class="heart">♡</span>
            <h3>
              {content.groom.toUpperCase()} &amp; {content.bride.toUpperCase()}
            </h3>
            <small>{content.dateLabel}</small>
          </div>
          <a href="#welcome" class="back-top">
            BACK TO THE BEGINNING ↑
          </a>
        </div>
      </section>
    </main>
    <div class="journey-controls">
      <button id="previous" aria-label="Previous page">
        ←
      </button>
      <button id="page-index" aria-label="Open page navigation">
        <span id="current-page">01</span>
        <span class="index-line"></span>
        <span>08</span>
      </button>
      <button id="next" aria-label="Next page">
        →
      </button>
      <span class="controls-divider"></span>
      <button id="motion" aria-pressed="false" aria-label="Pause animations">
        Ⅱ
      </button>
      {content.music.enabled && (
        <button id="music" aria-label="Play music" aria-pressed="false">
          ♫
        </button>
      )}
    </div>
  </div>
  <dialog id="info-dialog">
    <button class="dialog-close" aria-label="Close information">
      ×
    </button>
    <p class="eyebrow">COASTAL WEDDING EXPRESS</p>
    <div class="ornament" aria-hidden="true">
      <span></span>✧<span></span>
    </div>
    <h2 id="info-title"></h2>
    <div id="info-body"></div>
    <button class="primary-button dialog-done">
      BACK TO THE JOURNEY <span>⟶</span>
