---
import { content } from '../data/content';
import '../styles/styles.css';
import '../styles/opening.css';
import '../styles/typography.css';
import '../styles/events.css';
import '../styles/coastal-animations.css';
import '../styles/entrance.css';
import '../styles/countdown.css';
import '../styles/spacing.css';
import '../styles/refinements.css';
import '../styles/design-update.css';
const sceneVars = `:root{--welcome:url('${import.meta.env.BASE_URL}${content.assets.welcome}');--bridge:url('${import.meta.env.BASE_URL}${content.assets.bridge}');--garden:url('${import.meta.env.BASE_URL}${content.assets.garden}')}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#0b454b" />
    <meta name="description" content={content.site.description} />
    <title>{content.site.title}</title>
    <link rel="icon" href="favicon.svg" />
    <style is:inline set:html={sceneVars}></style>
    <script is:inline>
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      window.scrollTo(0, 0);
      if (location.hash && location.hash !== '#welcome') {
        history.replaceState(null, '', location.pathname + location.search);
      }
    </script>
  </head>
  <body>
    <slot />
    {content.music.enabled && (
      <audio id="wedding-music" src={`${content.music.src}?v=song-2`} preload="none" loop></audio>
    )}
    <script is:inline src="content.js?v=design-2"></script>
    <script is:inline src="app.js?v=design-7"></script>
    <script is:inline src="foliage.js?v=design-3"></script>
  </body>
</html>
